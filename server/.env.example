# Database — Prisma uses the standard postgresql:// scheme
# (Python tarafı 'postgresql+psycopg2://' kullanıyordu; Prisma için sadece 'postgresql://')
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Session / cookie secret
SECRET_KEY="change-me-to-a-long-random-string"

# Server
PORT=5000
NODE_ENV=development

# CORS — virgülle ayır, hepsi için '*' yaz
CORS_ORIGINS=http://localhost:5000

# Google OAuth (auth.py'deki gibi)
GOOGLE_CLIENT_ID=

# Cookie güvenlik (production'da true)
SESSION_COOKIE_SECURE=false

# MCP — Claude'un panoyu sürdüğü uç (POST /mcp).
#
# Biçim: virgül ya da satır sonuyla ayrılmış `kullanıcı_slug:anahtar` çiftleri.
# Anahtar KİŞİYE bağlıdır, ekibe değil: denetim kaydında "bunu kim yaptı"nın
# cevabı buradan geliyor ve bildirimin kime gideceğini bu belirliyor.
#
# Anahtar en az 24 karakter olmalı; kısası sessizce kabul edilmez, açılışta
# uyarıyla atılır. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Değişken tanımsızsa MCP ucu KAPALIDIR — her istek 401 alır. "Yapılandırma
# yoksa serbest bırak" davranışı bilinçli olarak yok.
STOA_MCP_TOKENS=
